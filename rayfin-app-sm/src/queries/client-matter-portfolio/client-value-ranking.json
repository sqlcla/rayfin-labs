{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Clients ranked by billed value.",
  "width": "container",
  "height": "container",
  "mark": "bar",
  "encoding": {
    "y": { "field": "ClientName", "type": "nominal", "title": "Client", "sort": "-x" },
    "x": { "field": "BilledValue", "type": "quantitative", "title": "Billed value (dollars)", "axis": { "format": "$,.0f" } },
    "tooltip": [
      { "field": "ClientRank", "type": "quantitative", "title": "Rank" },
      { "field": "MatterCount", "type": "quantitative", "title": "Matters", "format": ",.0f" },
      { "field": "OutstandingAmount", "type": "quantitative", "title": "Outstanding amount", "format": "$,.0f" }
    ]
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Billing and collection key performance indicators.",
  "width": "container",
  "height": "container",
  "mark": { "type": "text", "fontSize": 18, "fontWeight": "bold" },
  "encoding": {
    "text": { "field": "CollectionRate", "type": "quantitative", "format": ".0%", "title": "Collection rate" },
    "tooltip": [
      { "field": "InvoicedAmount", "type": "quantitative", "title": "Invoiced amount", "format": "$,.0f" },
      { "field": "PaidAmount", "type": "quantitative", "title": "Paid amount", "format": "$,.0f" },
      { "field": "OutstandingAmount", "type": "quantitative", "title": "Outstanding amount", "format": "$,.0f" },
      { "field": "InvoiceCount", "type": "quantitative", "title": "Invoices", "format": ",.0f" }
    ]
  }
}

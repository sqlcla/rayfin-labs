{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Monthly invoiced and paid amounts.",
  "width": "container",
  "height": "container",
  "transform": [
    { "fold": ["InvoicedAmount", "PaidAmount"], "as": ["Series", "Amount"] }
  ],
  "mark": { "type": "line", "point": true },
  "encoding": {
    "x": { "field": "MonthStart", "type": "temporal", "title": "Month", "axis": { "format": "%b %Y" } },
    "y": { "field": "Amount", "type": "quantitative", "title": "Amount (dollars)", "axis": { "format": "$,.0f" } },
    "color": { "field": "Series", "type": "nominal", "title": "Billing series" },
    "tooltip": [
      { "field": "MonthStart", "type": "temporal", "title": "Month", "format": "%B %Y" },
      { "field": "Series", "type": "nominal", "title": "Series" },
      { "field": "Amount", "type": "quantitative", "title": "Amount", "format": "$,.0f" }
    ]
  }
}
